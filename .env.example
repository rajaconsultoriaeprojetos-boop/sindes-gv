# Calculadora TRCT — OpenRouter (recomendado produção)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_SITE_URL=https://sindesgv.com.br
OPENROUTER_APP_NAME=SINDES Calculadora TRCT
# Alternativas diretas (legado)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASSESSORIA_CODIGO=
ADMIN_CODIGO=
# RBAC — login unificado (/entrar)
RBAC_SESSION_SECRET=
RBAC_BOOTSTRAP_SECRET=
SUPERADMIN_EMAILS=rajaconsultoriaeprojetos@gmail.com
# Opcional futuro OAuth Google
GOOGLE_CLIENT_ID=
# Google Sheets (opcional): JSON da conta de serviço em base64 ou caminho no servidor
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Calendário compartilhado com a conta de serviço (e-mail ou ID)
GOOGLE_CALENDAR_ID=sindesoficial@gmail.com

# Google Calendar + Meet (OAuth user — sindesgvoficial@gmail.com)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token: env OR arquivo (preferível)
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_PATH=/var/www/sindes/secrets/google-oauth-token.json
GOOGLE_OAUTH_REDIRECT_URI=https://www.sindesgv.com.br/api/admin/google-oauth/callback
